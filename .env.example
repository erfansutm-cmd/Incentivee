# Backend / Compose settings template.
# Copy to .env (project root) and fill in; Compose will auto-load it.

ENVIRONMENT=development

# ── Database (MySQL) ──────────────────────────────────────────
DB_HOST=172.21.41.75      # LAN IP of the DB server
DB_PORT=3306
DB_USER=erfan.mohamadi
DB_PASSWORD=              # put the real password in .env (never commit it)
DB_NAME=incentive         # schema name (CREATE DATABASE incentive CHARACTER SET utf8mb4)

# ── API path (optional) ───────────────────────────────────────
# Base path the API is mounted under (default /api; e.g. /api/v1)
# API_PREFIX=/api

# ── Frontend note ─────────────────────────────────────────────
# The front-end's main API URL is NOT set here. Vite reads it from
# frontend/.env.development and frontend/.env.production:
#   VITE_API_BASE_URL=                        # empty = same origin (default)
#   VITE_API_BASE_URL=https://api.example.com # call a remote API directly
