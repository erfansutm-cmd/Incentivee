# Backend / Compose settings.
# Copy to .env (project root) and Compose will auto-load it.

# development | production
ENVIRONMENT=development

# Base path the API is mounted under (default /api; e.g. /api/v1)
# API_PREFIX=/api

# ── Database (MySQL) ─────────────────────────────────────────
# Copy this file to .env (never commit real credentials — .env is
# already git-ignored) and fill in your instance's values.
DB_HOST=172.21.41.75
DB_PORT=3306
DB_USER=erfan.mohamadi
DB_PASSWORD=
DB_NAME=incentive

# ── Frontend note ──────────────────────────────────────────────
# The front-end's main API URL is NOT set here. Vite reads it from
# frontend/.env.development and frontend/.env.production:
#   VITE_API_BASE_URL=                        # empty = same origin (default)
#   VITE_API_BASE_URL=https://api.example.com # call a remote API directly
